# findpic bot configuration — TEMPLATE ONLY.
#
#   ┌─────────────────────────────────────────────────────────────────────┐
#   │  THIS FILE IS TRACKED IN GIT. Never put a real token here — it       │
#   │  would be published the moment you commit.                          │
#   │                                                                      │
#   │      cp deploy/.env.example deploy/.env                              │
#   │                                                                      │
#   │  Put the token in `deploy/.env`, which is gitignored. Both the bot   │
#   │  and `python -m findpic.bot --setup` read it automatically.          │
#   └─────────────────────────────────────────────────────────────────────┘
#
# A real environment variable always wins over this file, so
# `BOT_TOKEN=... python -m findpic.bot --setup` overrides it for one run.
#
# On the VPS this file is written by the deploy workflow from GitHub secrets, so
# edit the secret rather than the file if you want a change to survive a deploy.

# ---------------------------------------------------------------- required

# From @BotFather. Format: 1234567890:AA...
BOT_TOKEN=

# ------------------------------------------------------------- host identity

# The UID/GID the container runs as. This MUST equal the host user that the
# shared Bot API volume's ACL grants read access to — check with `id -u <user>`.
# The ACL is keyed by number, so a mismatch denies every read and shows up only
# as a PermissionError per photo.
APP_UID=1000
APP_GID=1000

# ------------------------------------------------------------------ access

# Empty means anyone can use the bot. Comma-separated Telegram user IDs restrict
# it to those people; everyone else is told the bot is private and shown their
# own ID so they can ask to be added.
ALLOWED_USER_IDS=

# Exempt from throttling and the daily quota. Your own ID belongs here.
ADMIN_USER_IDS=

# ------------------------------------------------------------------- limits

# Seconds a user must wait between analyses.
THROTTLE_SECONDS=3

# Analyses per user per day. 0 disables the quota.
DAILY_QUOTA=50

# Largest file the bot will accept, in megabytes. The local Bot API server
# allows up to 2000; the cloud API caps downloads at 20 regardless of this.
MAX_FILE_MB=64

# ---------------------------------------------------------------- analytics

# Record who used the bot: the Telegram account, what they asked for, when, and
# which camera their photos named. Never message text, never a filename, never
# a coordinate — see scripts/bot-stats.py, which reads this back.
#
# 0 turns it off entirely; the bot then keeps nothing but the language choice.
# Whatever you set here, /privacy has to keep telling the truth about it.
ANALYTICS=1

# How long that record is kept, in days. 0 keeps it forever, which is a
# decision rather than a default.
ANALYTICS_RETENTION_DAYS=90

# Also record the day a photo was taken and the town it was taken in — never
# the exact second, never a street, never more than two decimal places of a
# coordinate. Off by default, because with this off the bot can say truthfully
# that it never records where a picture was taken. Implied by ARCHIVE_DIR.
ANALYTICS_CAPTURE=0

# ------------------------------------------------------------------ archive

# Keep a copy of every picture the bot is sent, so you can see what it is being
# used on. Empty means keep nothing, which is the default: this is a decision
# about other people's photographs, not a setting.
#
# Two variables, because the container and the host see different paths.
# ARCHIVE_HOST_DIR must be an ABSOLUTE path outside this checkout — the deploy
# workflow runs `git clean -qfd` and would delete an archive inside it — and
# must already exist and be owned by APP_UID. Docker creates a missing bind
# source as root:root, and the container could then never write to it.
#
#   mkdir -p ~/findpic-archive && chmod 750 ~/findpic-archive
#   ARCHIVE_HOST_DIR=/home/you/findpic-archive
#   ARCHIVE_DIR=/archive
#
# Turning this on changes what /privacy tells your users, automatically and in
# both languages. Read it once after you do.
ARCHIVE_HOST_DIR=
ARCHIVE_DIR=

# How long a kept picture is kept. Clamped to ANALYTICS_RETENTION_DAYS when
# that is shorter: past it the sender's name is deleted, and a photograph that
# outlived the row naming them is a stranger's picture nothing can attribute.
ARCHIVE_RETENTION_DAYS=30

# Ceilings, in megabytes. The archive shares a filesystem with the database,
# and the first thing a full disk breaks is the write the bot needs to answer
# anyone — hence the free-space floor, which is a refusal, not a target.
# Reaching a ceiling refuses the new picture; it never deletes an old one.
#
# Note ADMIN_USER_IDS bypasses the throttle and the daily quota outright, so
# for your own account ARCHIVE_MAX_USER_MB is the only limit there is.
ARCHIVE_MAX_FILE_MB=32
ARCHIVE_MAX_TOTAL_MB=4096
ARCHIVE_MAX_USER_MB=512
ARCHIVE_MIN_FREE_MB=2048

# --------------------------------------------------------------- behaviour

# Fallback when a user has not chosen one and their Telegram client language is
# not one findpic speaks. One of: en, uk
BOT_DEFAULT_LANGUAGE=en

# How long the buttons under a report keep working, in seconds.
# (Set in code; listed here for visibility.)
# ANALYSIS_TTL_SECONDS=86400

# DEBUG turns on aiogram's request logging. Leave at INFO in production —
# DEBUG can put file identifiers in the logs.
LOG_LEVEL=INFO

# Ignore updates that queued up while the bot was down. Recommended: a restart
# should not replay yesterday's photos.
DROP_PENDING_UPDATES=1
